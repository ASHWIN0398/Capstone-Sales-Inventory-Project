      <aliases enabled='yes' />
      <column caption='Inventory Turnover' datatype='real' name='[Calculation_208572982444548096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([SoldCount]) * AVG([PriceReg])) / AVG([ItemCount])' />
      </column>
      <column caption='Stock-to-Sales Ratio' datatype='real' name='[Calculation_208572982444630017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([ItemCount]  / [SoldCount])' />
      </column>
      <column caption='Low Stock Indicator' datatype='integer' name='[Calculation_208572982445719554]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [ItemCount] &gt; 0 AND [ItemCount] &lt;= 10 THEN [ItemCount] END' />
      </column>
      <column caption='Reorder Point' datatype='real' name='[Calculation_208572982446030851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Calculate the average daily sales&#13;&#10;AVG([SoldCount]) * 7 + 100' />
      </column>
      <column caption='Rank by SoldCount' datatype='boolean' name='[Calculation_208572982481076228]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([SoldCount]), &apos;desc&apos;) &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Discount Impact' datatype='real' name='[Calculation_208572982487212037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([PriceReg] - [LowUserPrice]) / [PriceReg]' />
      </column>
      <column caption='Price Difference' datatype='real' name='[Calculation_208572982771232775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PriceReg] - [LowUserPrice]' />
      </column>
      <column caption='Sales-Regular' datatype='real' name='[Calculation_331577548379525120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SoldCount]* [PriceReg]' />
      </column>
      <column caption='File Type' datatype='string' name='[File_Type]' role='dimension' type='nominal' />
      <column caption='Item Count' datatype='integer' name='[ItemCount]' role='measure' type='quantitative' />
      <column caption='Low Net Price' datatype='real' name='[LowNetPrice]' role='measure' type='quantitative' />
      <column caption='Low User Price' datatype='real' name='[LowUserPrice]' role='measure' type='quantitative' />
      <column caption='Marketing Type' datatype='string' name='[MarketingType]' role='dimension' type='nominal' />
