  <actions>
    <action caption='Marketing-type' name='[Action2_2E00D16722354CF9BED51A6011AECBD3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Dashboard-Analysis' type='sheet'>
        <exclude-sheet name='Low-Stock Items' />
        <exclude-sheet name=' Inventory Turnover ' />
        <exclude-sheet name='Unit-Sold' />
        <exclude-sheet name='Sales Trends Over Time' />
        <exclude-sheet name='Top-Selling Products' />
        <exclude-sheet name='Total-REG' />
        <exclude-sheet name='Total-DIS' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='Dashboard-Analysis' />
      </command>
    </action>
    <action caption='SKU-number' name='[Action2_819DA238FDEF41D58558224B360AEA39]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Dashboard-Analysis' type='sheet' worksheet='Top-Selling Products' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Low-Stock Items,Top-Selling Products' />
        <param name='special-fields' value='all' />
        <param name='target' value='Dashboard-Analysis' />
      </command>
    </action>
    <action caption='Release-Year' name='[Action3_12E88752FBCD44B087C1C2C08E642FB4]'>
